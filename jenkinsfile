pipeline {
    agent { label 'master' }

    tools {
        maven 'maven-1'
    }

    parameters {
        string(
            name: 'GIT_REPO_URL',
            defaultValue: 'https://github.com/uday745/Skillcraft-Technology-Website.git',
            description: 'Git repository URL'
        )

        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'Git branch to clone'
        )

        credentials(
            name: 'GIT_CREDENTIALS',
            defaultValue: 'GITHUB',
            description: 'Git credentials ID'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: params.GIT_BRANCH,
                    credentialsId: params.GIT_CREDENTIALS,
                    url: params.GIT_REPO_URL
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh '''
                      mvn clean verify sonar:sonar \
                      -Dsonar.projectKey=skillcraft-java \
                      -Dsonar.projectName=Skillcraft-Java
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    script {
                        def qg = waitForQualityGate()

                        if (qg.status == 'OK') {
                            echo "✅ Quality Gate PASSED"
                        } else {
                            echo "❌ Quality Gate FAILED: ${qg.status}"
                            error("Pipeline failed due to Quality Gate failure")
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline completed successfully"
        }
        failure {
            echo "🚨 Pipeline failed"
        }
        always {
            cleanWs()
        }
    }
}
