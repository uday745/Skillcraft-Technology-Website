pipeline {
    agent { label 'master' }

    tools {
        maven 'maven-1'
    }

    parameters {
        string(
            name: 'GIT_REPO_URL',
            defaultValue: 'https://github.com/uday745/Skillcraft-Technology-Website.git',
            description: 'Git repository URL'
        )

        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'Git branch to clone'
        )

        credentials(
            name: 'GIT_CREDENTIALS',
            defaultValue: 'GITHUB',
            description: 'Git credentials ID'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: params.GIT_BRANCH,
                    credentialsId: params.GIT_CREDENTIALS,
                    url: params.GIT_REPO_URL
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    if (params.GIT_BRANCH == 'main') {
                        echo "Running SonarQube analysis on MAIN branch"

                        withSonarQubeEnv('sonar') {
                            sh '''
                              mvn clean verify sonar:sonar \
                              -Dsonar.projectKey=skillcraft-java \
                              -Dsonar.projectName=Skillcraft-Java
                            '''
                        }
                    } else {
                        echo "Skipping SonarQube analysis for branch: ${params.GIT_BRANCH}"
                    }
                }
            }
        }

        stage('Quality Gate') {
            when {
                expression { params.GIT_BRANCH == 'main' }
            }
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    script {
                        def qg = waitForQualityGate()

                        if (qg.status == 'OK') {
                            echo "✅ Quality Gate PASSED"
                        } else {
                            echo "❌ Quality Gate FAILED: ${qg.status}"
                            error("Pipeline failed due to Quality Gate failure")
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline completed successfully"
        }
        failure {
            echo "🚨 Pipeline failed"
        }
        always {
            cleanWs()
        }
    }
}
